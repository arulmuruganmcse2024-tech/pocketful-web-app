{
  "name": "pocketful-dark-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit",
    "start": "node server.ts",
    "lint": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test test.ts",
