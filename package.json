    "test:all": "npm test && npm run test:multi"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
